// SHADOW IDX data model.
//
// Two jobs: persist user watchlists and portfolios, and cache Sectors API
// responses durably. The cache table is what actually protects the 1,000
// credit budget, since an in-process cache is empty after every cold start and
// is not shared between serverless instances.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  /// Interface language, used for scheduled notifications sent with no
  /// active browser session to read a cookie from. Kept in sync with the
  /// viewer's cookie choice on each authenticated request; "en" or "id".
  locale       String   @default("en")
  /// Null until the sign up verification link is clicked. Sign in is
  /// refused while this is null, so an account cannot be used with an email
  /// address its holder does not control.
  emailVerifiedAt   DateTime?
  /// Bumped on every successful password reset. A session cookie issued
  /// before this moment is treated as invalid, which is what forces every
  /// other signed-in browser to sign in again after a reset.
  passwordChangedAt DateTime?
  /// Opted in to the daily market brief email. Off by default: a daily email
  /// nobody asked for is the fastest way to train people to ignore alerts.
  briefOptIn   Boolean  @default(false)
  createdAt    DateTime @default(now())

  watchlistItems WatchlistItem[]
  holdings       Holding[]
  notifications  Notification[]
  authTokens     AuthToken[]
  loginOtps      LoginOtp[]

  @@map("users")
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Single use, expiring tokens for email verification and password reset
/// links. Only a hash of the token is stored, the same reasoning as a
/// password hash: a database leak must not hand out working links.
model AuthToken {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// One outstanding one time code for the second step of sign in. Only a
/// hash of the code is stored. Capped attempts stop the six digit space
/// from being brute forced inside the code's own expiry window.
model LoginOtp {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  /// The remember me choice made at the password step, carried through to
  /// the session once the code is verified.
  rememberMe Boolean   @default(false)
  attempts   Int       @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_otps")
}

model WatchlistItem {
  id     String @id @default(cuid())
  userId String
  symbol String

  /// Alert when the absolute divergence z-score exceeds this. Per symbol so a
  /// volatile small cap and a steady blue chip can have different bars.
  zScoreThreshold Float @default(2.0)

  notifyOnCorporateAction Boolean @default(true)
  notifyOnSmartMoney      Boolean @default(true)

  /// Guards against re-sending the same alert on every scheduled run.
  lastNotifiedAt   DateTime?
  lastNotifiedZ    Float?

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([symbol])
  @@map("watchlist_items")
}

/// A position, used to express corporate action effects in rupiah rather than
/// as abstract ratios.
model Holding {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  lots      Int
  avgPrice  Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@map("holdings")
}

enum NotificationKind {
  DIVERGENCE
  CORPORATE_ACTION
  SMART_MONEY
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  symbol  String
  kind    NotificationKind
  title   String
  /// Pre-rendered summary, so the history does not depend on re-running an
  /// analysis whose inputs have since changed.
  body    String
  payload Json?

  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Durable cache for Sectors API responses.
///
/// Keyed by full request URL. Survives restarts and is shared across instances,
/// which is what keeps repeated demo runs inside the credit budget.
model ApiCache {
  key       String   @id
  payload   Json
  /// Credits the original call cost, for reporting what caching saved.
  creditCost Int     @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("api_cache")
}

/// Append-only ledger of API spending, so the budget is auditable rather than
/// a number held in memory that resets on deploy.
model CreditUsage {
  id        String   @id @default(cuid())
  endpoint  String
  cost      Int
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("credit_usage")
}

enum RunStatus {
  /// Stocks are still being analysed.
  ANALYSING
  /// Analysis finished; alerts and emails are being sent.
  DELIVERING
  DONE
  /// Superseded by the next day's run before it finished.
  ABANDONED
}

enum RunItemStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  /// Not analysed because the day's credit cap was reached.
  SKIPPED
}

/// One trading day's automated run.
///
/// The work is split into one item per stock so it can be spread across
/// several short function invocations: a hosting plan's time limit then caps
/// one stock's analysis, not the whole day's.
model MarketRun {
  id            String    @id @default(cuid())
  /// Trading date in Jakarta time, YYYY-MM-DD.
  runDate       String    @unique
  status        RunStatus @default(ANALYSING)
  /// Credits this run may spend, fixed when the run starts.
  creditCap     Int
  creditsSpent  Int       @default(0)
  /// Self-triggered continuations so far, capped to stop a runaway chain.
  continuations Int       @default(0)
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items RunItem[]

  @@map("market_runs")
}

model RunItem {
  id           String        @id @default(cuid())
  runId        String
  symbol       String
  status       RunItemStatus @default(PENDING)
  /// Order to process in: watched stocks first, the default universe after.
  position     Int
  claimedAt    DateTime?
  attempts     Int           @default(0)
  creditsSpent Int?
  error        String?

  run MarketRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, symbol])
  @@index([runId, status])
  @@map("run_items")
}

/// One stock's analysis on one trading day, kept as history.
///
/// This is what makes the product checkable: every divergence the app ever
/// reported is stored with what happened next, so the track record page can
/// show whether the signal has meant anything, instead of asserting that it
/// does.
model SignalSnapshot {
  id               String  @id @default(cuid())
  symbol           String
  runDate          String
  /// Last trading session in the analysed data.
  asOf             String
  companyName      String
  sector           String?
  zScore           Float
  verdict          String
  fitQuality       Float
  constituentCount Int
  totalReturn      Float
  marketReturn     Float
  sectorReturn     Float
  idioReturn       Float
  realityVerdict   String
  smartMoneyType   String?
  smartMoneyConviction Float?
  /// The full shadow, reality check and smart money results, so alerts and
  /// the brief are built from exactly what was analysed, with no re-fetch.
  analysis         Json
  /// Raw corporate actions, so each user's rupiah effect can be computed
  /// from their own holding later without spending another credit.
  corporateActions Json?

  /// Filled in by a later run, once enough sessions have passed.
  forwardSessions    Int?
  forwardStockReturn Float?
  forwardTwinReturn  Float?
  resolvedAt         DateTime?

  createdAt DateTime @default(now())

  @@unique([symbol, runDate])
  @@index([runDate])
  @@index([symbol, resolvedAt])
  @@map("signal_snapshots")
}

/// The full IDX ticker directory, downloaded once from the screener endpoint
/// and refreshed periodically.
///
/// This exists so the search dropdown can match symbol and company name
/// instantly, client side, without spending a credit or waiting on a network
/// round trip per keystroke. Listing changes rarely enough that a daily or
/// weekly refresh is more than sufficient.
model CompanyDirectoryEntry {
  symbol      String   @id
  companyName String
  updatedAt   DateTime @updatedAt

  @@index([companyName])
  @@map("company_directory")
}
