// SHADOW IDX data model.
//
// Two jobs: persist user watchlists and portfolios, and cache Sectors API
// responses durably. The cache table is what actually protects the 1,000
// credit budget, since an in-process cache is empty after every cold start and
// is not shared between serverless instances.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String?
  /// Interface language, used for scheduled notifications sent with no
  /// active browser session to read a cookie from. Kept in sync with the
  /// viewer's cookie choice on each authenticated request; "en" or "id".
  locale            String    @default("en")
  /// Null until the sign up verification link is clicked. Sign in is
  /// refused while this is null, so an account cannot be used with an email
  /// address its holder does not control.
  emailVerifiedAt   DateTime?
  /// Bumped on every successful password reset. A session cookie issued
  /// before this moment is treated as invalid, which is what forces every
  /// other signed-in browser to sign in again after a reset.
  passwordChangedAt DateTime?
  /// Opted in to the daily market brief email. Off by default: a daily email
  /// nobody asked for is the fastest way to train people to ignore alerts.
  briefOptIn        Boolean   @default(false)
  /// ADMIN opens the admin panel. Granted by another admin, by the
  /// migration that created the column, or by `npm run admin:grant`.
  role              Role      @default(USER)
  /// "Sign out everywhere": a session issued before this is rejected, the
  /// same mechanism as passwordChangedAt but without changing the password.
  sessionsRevokedAt DateTime?
  /// Personal settings (analysis panel layout, defaults), read through the
  /// Zod schema in src/lib/settings/user.ts so a bad value falls back.
  preferences       Json?
  createdAt         DateTime  @default(now())

  watchlistItems WatchlistItem[]
  holdings       Holding[]
  notifications  Notification[]
  authTokens     AuthToken[]
  loginOtps      LoginOtp[]
  chatThreads    ChatThread[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Single use, expiring tokens for email verification and password reset
/// links. Only a hash of the token is stored, the same reasoning as a
/// password hash: a database leak must not hand out working links.
model AuthToken {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// One outstanding one time code for the second step of sign in. Only a
/// hash of the code is stored. Capped attempts stop the six digit space
/// from being brute forced inside the code's own expiry window.
model LoginOtp {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  /// The remember me choice made at the password step, carried through to
  /// the session once the code is verified.
  rememberMe Boolean   @default(false)
  attempts   Int       @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_otps")
}

model WatchlistItem {
  id     String @id @default(cuid())
  userId String
  symbol String

  /// Alert when the absolute divergence z-score exceeds this. Per symbol so a
  /// volatile small cap and a steady blue chip can have different bars.
  zScoreThreshold Float @default(2.0)

  notifyOnCorporateAction Boolean @default(true)
  notifyOnSmartMoney      Boolean @default(true)

  /// Guards against re-sending the same alert on every scheduled run.
  lastNotifiedAt DateTime?
  lastNotifiedZ  Float?

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules     AlertRule[]

  @@unique([userId, symbol])
  @@index([symbol])
  @@map("watchlist_items")
}

/// A position, used to express corporate action effects in rupiah rather than
/// as abstract ratios.
model Holding {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  lots      Int
  avgPrice  Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@map("holdings")
}

enum NotificationKind {
  DIVERGENCE
  CORPORATE_ACTION
  SMART_MONEY
  RULE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  symbol  String
  kind    NotificationKind
  title   String
  /// Pre-rendered summary, so the history does not depend on re-running an
  /// analysis whose inputs have since changed.
  body    String
  payload Json?

  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Durable cache for Sectors API responses.
///
/// Keyed by full request URL. Survives restarts and is shared across instances,
/// which is what keeps repeated demo runs inside the credit budget.
model ApiCache {
  key        String   @id
  payload    Json
  /// Credits the original call cost, for reporting what caching saved.
  creditCost Int      @default(1)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
  @@map("api_cache")
}

/// Append-only ledger of API spending, so the budget is auditable rather than
/// a number held in memory that resets on deploy.
model CreditUsage {
  id        String   @id @default(cuid())
  endpoint  String
  cost      Int
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("credit_usage")
}

enum RunStatus {
  /// Stocks are still being analysed.
  ANALYSING
  /// Analysis finished; alerts and emails are being sent.
  DELIVERING
  DONE
  /// Superseded by the next day's run before it finished.
  ABANDONED
}

enum RunItemStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  /// Not analysed because the day's credit cap was reached.
  SKIPPED
}

/// One trading day's automated run.
///
/// The work is split into one item per stock so it can be spread across
/// several short function invocations: a hosting plan's time limit then caps
/// one stock's analysis, not the whole day's.
model MarketRun {
  id            String    @id @default(cuid())
  /// Trading date in Jakarta time, YYYY-MM-DD.
  runDate       String    @unique
  status        RunStatus @default(ANALYSING)
  /// Credits this run may spend, fixed when the run starts.
  creditCap     Int
  creditsSpent  Int       @default(0)
  /// Self-triggered continuations so far, capped to stop a runaway chain.
  continuations Int       @default(0)
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items RunItem[]

  @@map("market_runs")
}

model RunItem {
  id           String        @id @default(cuid())
  runId        String
  symbol       String
  status       RunItemStatus @default(PENDING)
  /// Order to process in: watched stocks first, the default universe after.
  position     Int
  claimedAt    DateTime?
  attempts     Int           @default(0)
  creditsSpent Int?
  error        String?

  run MarketRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, symbol])
  @@index([runId, status])
  @@map("run_items")
}

/// One stock's analysis on one trading day, kept as history.
///
/// This is what makes the product checkable: every divergence the app ever
/// reported is stored with what happened next, so the track record page can
/// show whether the signal has meant anything, instead of asserting that it
/// does.
model SignalSnapshot {
  id                   String  @id @default(cuid())
  symbol               String
  runDate              String
  /// Last trading session in the analysed data.
  asOf                 String
  companyName          String
  sector               String?
  zScore               Float
  verdict              String
  fitQuality           Float
  constituentCount     Int
  totalReturn          Float
  marketReturn         Float
  sectorReturn         Float
  idioReturn           Float
  realityVerdict       String
  smartMoneyType       String?
  smartMoneyConviction Float?
  /// The full shadow, reality check and smart money results, so alerts and
  /// the brief are built from exactly what was analysed, with no re-fetch.
  analysis             Json
  /// Raw corporate actions, so each user's rupiah effect can be computed
  /// from their own holding later without spending another credit.
  corporateActions     Json?
  /// The run's key statistics and price and volume facts, stored so the
  /// watchlist and custom alert rules can use them without another request.
  /// Null on snapshots stored before these columns existed.
  keyStats             Json?
  marketFacts          Json?

  /// Filled in by a later run, once enough sessions have passed.
  forwardSessions    Int?
  forwardStockReturn Float?
  forwardTwinReturn  Float?
  resolvedAt         DateTime?

  createdAt DateTime @default(now())

  @@unique([symbol, runDate])
  @@index([runDate])
  @@index([symbol, resolvedAt])
  @@map("signal_snapshots")
}

/// The full IDX ticker directory, downloaded once from the screener endpoint
/// and refreshed periodically.
///
/// This exists so the search dropdown can match symbol and company name
/// instantly, client side, without spending a credit or waiting on a network
/// round trip per keystroke. Listing changes rarely enough that a daily or
/// weekly refresh is more than sufficient.
model CompanyDirectoryEntry {
  symbol      String   @id
  companyName String
  /// Null until known. Filled from analyses already stored, so the ticker
  /// list says how many sectors it knows rather than implying full coverage.
  sector      String?
  updatedAt   DateTime @updatedAt

  @@index([companyName])
  @@index([sector])
  @@map("company_directory")
}

// Admin-managed site settings. Each table is small and read once per
// request (see src/lib/brand/settings.ts), so plain rows beat a key-value
// blob: every field is typed and validated by Prisma as well as by Zod.

/// A colour palette. The built-in palette lives in globals.css and applies
/// whenever no row is active, so it can never be deleted by accident.
model BrandPalette {
  id                String   @id @default(cuid())
  name              String
  isActive          Boolean  @default(false)
  lightAccent       String
  lightAccentHover  String
  lightAccentBright String
  lightAccentSoft   String
  darkAccent        String
  darkAccentHover   String
  darkAccentBright  String
  darkAccentSoft    String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("brand_palettes")
}

enum BrandAssetKind {
  LOGO
  FAVICON
}

/// An uploaded logo or favicon. Stored in Postgres because the host has no
/// persistent filesystem; uploads are capped at 512 KB, so this stays small.
model BrandAsset {
  id        String         @id @default(cuid())
  kind      BrandAssetKind
  name      String
  mimeType  String
  data      Bytes
  size      Int
  isActive  Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([kind, isActive])
  @@map("brand_assets")
}

/// An admin edit to one landing page string, in one language. Deleting the
/// row restores the dictionary default.
model ContentOverride {
  id        String   @id @default(cuid())
  key       String
  locale    String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
  @@map("content_overrides")
}

enum AnnouncementTone {
  INFO
  WARNING
  SUCCESS
}

enum AnnouncementAudience {
  ALL
  SIGNED_IN
  GUESTS
}

model Announcement {
  id          String               @id @default(cuid())
  messageEn   String
  messageId   String
  tone        AnnouncementTone     @default(INFO)
  audience    AnnouncementAudience @default(ALL)
  linkUrl     String?
  linkLabelEn String?
  linkLabelId String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("announcements")
}

/// The default stock list for the daily run. When any row is active it
/// replaces the MARKET_UNIVERSE environment variable.
model UniverseStock {
  symbol    String   @id
  position  Int
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  @@map("universe_stocks")
}

/// Who changed what in the admin panel.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  target     String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("admin_audit_log")
}

/// App wide settings, one row per group. The value is parsed by the Zod
/// schemas in src/lib/settings/app.ts, which fill in defaults and refuse
/// signal bounds looser than the shipped ones.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// The tickers scrolling on the landing page. With no active row the
/// built-in list in TickerMarquee.tsx is shown.
model TickerStripItem {
  symbol    String   @id
  position  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("ticker_strip")
}

/// A chatbot conversation. Deleted with its user.
model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_threads")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id               String     @id @default(cuid())
  threadId         String
  role             ChatRole
  content          String
  /// Token usage reported by the model for this reply, for the admin view.
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime   @default(now())
  thread           ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([createdAt])
  @@map("chat_messages")
}

enum RuleMetric {
  PRICE
  CHANGE_1D
  VOLUME
  VOLUME_RATIO
  RETURN_5D
  Z_SCORE
  STOCK_SPECIFIC
  PE
  PB
  DIVIDEND_YIELD
  RANGE_POSITION
}

enum RuleOperator {
  LT
  LTE
  EQ
  GTE
  GT
}

/// A user's own alert condition on one watched stock, checked once per
/// trading day after the close (see src/lib/notifications/custom-rules.ts).
/// It fires when the condition becomes true, not on every day it stays true.
model AlertRule {
  id              String        @id @default(cuid())
  watchlistItemId String
  metric          RuleMetric
  operator        RuleOperator
  value           Float
  enabled         Boolean       @default(true)
  /// When set, the value is recomputed from the newest data after each run
  /// with this suggestion preset, so the band follows the stock.
  autoTune        Boolean       @default(false)
  preset          String?
  note            String?
  lastMet         Boolean?
  lastValue       Float?
  lastCheckedAt   DateTime?
  lastTriggeredAt DateTime?
  tunedAt         DateTime?
  createdAt       DateTime      @default(now())
  watchlistItem   WatchlistItem @relation(fields: [watchlistItemId], references: [id], onDelete: Cascade)

  @@index([watchlistItemId])
  @@map("alert_rules")
}
