# Copy to .env.local and fill in. Never commit the filled version.

# Sectors API key from https://sectors.app (Authorization header, raw key).
SECTORS_API_KEY=

# Credit budget guard. The hackathon grants 1000 credits for the whole build;
# the reserve is held back so background jobs cannot starve the live demo.
SECTORS_CREDIT_LIMIT=1000
SECTORS_CREDIT_RESERVE=150

# Stretches the short cache windows for prices, news and the index.
# 1 is normal. Raise it while rehearsing a demo so the same prices are not
# re-bought every fifteen minutes; 24 holds them for roughly a day.
SECTORS_CACHE_BOOST=1

# Postgres connection string (Neon, Supabase, or local).
DATABASE_URL=postgresql://user:password@localhost:5432/shadowidx

# Shared secret for the scheduled notification endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Session signing secret. Generate the same way as CRON_SECRET.
AUTH_SECRET=

# SMTP delivery for alert emails. Optional: without a complete set,
# notifications are stored in-app only and nothing is mailed.
#
# Works with any SMTP relay. For Gmail, create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD;
# your normal account password will be rejected.
#
# Port 465 uses implicit TLS. Any other port starts plaintext and is
# required to upgrade via STARTTLS, so credentials are never sent in clear.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=

# Chatbot (optional). An xAI API key from console.x.ai. Without it the chat
# button is hidden. The model and daily limit are set in Admin > Settings.
XAI_API_KEY=
