# Copy to .env.local and fill in. Never commit the filled version.

# Sectors API key from https://sectors.app (Authorization header, raw key).
SECTORS_API_KEY=

# Credit budget guard. The hackathon grants 1000 credits for the whole build;
# the reserve is held back so background jobs cannot starve the live demo.
SECTORS_CREDIT_LIMIT=1000
SECTORS_CREDIT_RESERVE=150

# Postgres connection string (Neon, Supabase, or local).
DATABASE_URL=postgresql://user:password@localhost:5432/shadowidx

# Shared secret for the scheduled notification endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Session signing secret. Generate the same way as CRON_SECRET.
AUTH_SECRET=

# Email delivery for notifications. Optional in development: without these,
# notifications are stored in-app only.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
